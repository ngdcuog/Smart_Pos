<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Style.Badge.Base" TargetType="Border"><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="6,2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Style.Badge.Success" TargetType="Border" BasedOn="{StaticResource Style.Badge.Base}"><Setter Property="Background" Value="{StaticResource Brush.Status.SuccessSurface}"/></Style>
  <Style x:Key="Style.Badge.Warning" TargetType="Border" BasedOn="{StaticResource Style.Badge.Base}"><Setter Property="Background" Value="{StaticResource Brush.Status.WarningSurface}"/></Style>
  <Style x:Key="Style.Badge.Danger" TargetType="Border" BasedOn="{StaticResource Style.Badge.Base}"><Setter Property="Background" Value="{StaticResource Brush.Status.DangerSurface}"/></Style>
</ResourceDictionary>
