<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Primary">#2563EB</Color>
    <Color x:Key="Color.PrimaryHover">#1D4ED8</Color>
    <Color x:Key="Color.PrimaryPressed">#1E40AF</Color>
    <Color x:Key="Color.PrimarySurface">#EFF6FF</Color>
    <Color x:Key="Color.AppBackground">#F8FAFC</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceSecondary">#F1F5F9</Color>
    <Color x:Key="Color.Border">#E2E8F0</Color>
    <Color x:Key="Color.BorderStrong">#CBD5E1</Color>
    <Color x:Key="Color.TextPrimary">#0F172A</Color>
    <Color x:Key="Color.TextSecondary">#64748B</Color>
    <Color x:Key="Color.TextMuted">#94A3B8</Color>
    <Color x:Key="Color.Success">#16A34A</Color>
    <Color x:Key="Color.Warning">#D97706</Color>
    <Color x:Key="Color.Danger">#DC2626</Color>
    <Color x:Key="Color.Info">#0284C7</Color>
    <Color x:Key="Color.SuccessSurface">#F0FDF4</Color>
    <Color x:Key="Color.DangerSurface">#FEF2F2</Color>
    <Color x:Key="Color.WarningSurface">#FFFBEB</Color>
    <Color x:Key="Color.InfoSurface">#F0F9FF</Color>

    <SolidColorBrush x:Key="Brush.Action.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.Action.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.Action.PrimaryPressed" Color="{StaticResource Color.PrimaryPressed}" />
    <SolidColorBrush x:Key="Brush.Action.PrimarySurface" Color="{StaticResource Color.PrimarySurface}" />
    <SolidColorBrush x:Key="Brush.Background.App" Color="{StaticResource Color.AppBackground}" />
    <SolidColorBrush x:Key="Brush.Background.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Background.SurfaceSecondary" Color="{StaticResource Color.SurfaceSecondary}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.Status.SuccessSurface" Color="{StaticResource Color.SuccessSurface}" />
    <SolidColorBrush x:Key="Brush.Status.DangerSurface" Color="{StaticResource Color.DangerSurface}" />
    <SolidColorBrush x:Key="Brush.Status.WarningSurface" Color="{StaticResource Color.WarningSurface}" />
    <SolidColorBrush x:Key="Brush.Status.InfoSurface" Color="{StaticResource Color.InfoSurface}" />

    <Thickness x:Key="Spacing.4">4</Thickness>
    <Thickness x:Key="Spacing.8">8</Thickness>
    <Thickness x:Key="Spacing.12">12</Thickness>
    <Thickness x:Key="Spacing.16">16</Thickness>
    <Thickness x:Key="Spacing.20">20</Thickness>
    <Thickness x:Key="Spacing.24">24</Thickness>
</ResourceDictionary>
