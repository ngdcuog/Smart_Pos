<UserControl x:Class="SmartPOS.Views.PlaceholderContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource Spacing.24}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" Style="{StaticResource Style.Text.PageTitle}" />
        <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Style.Text.Secondary}" Margin="0,8,0,0" />
        <Border Grid.Row="3" Style="{StaticResource Style.Card.Default}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Đang chuẩn bị" Style="{StaticResource Style.Text.SectionTitle}" />
                <TextBlock Text="{Binding DevelopmentMessage}" Style="{StaticResource Style.Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
