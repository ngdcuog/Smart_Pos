<UserControl x:Class="SmartPOS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartPOS.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style x:Key="Style.InventoryGrid.Row" TargetType="DataGridRow" BasedOn="{StaticResource Style.DataGrid.ManagementRow}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#F1F5F9" /><Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.InventoryGrid" TargetType="DataGrid" BasedOn="{StaticResource Style.DataGrid.Management}">
            <Setter Property="RowHeight" Value="48" />
            <Setter Property="RowStyle" Value="{StaticResource Style.InventoryGrid.Row}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="Style.InventoryFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Secondary}">
            <Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" />
            <RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Kho hàng" Style="{StaticResource Style.Text.PageTitle}" />
                <TextBlock Text="Theo dõi tồn kho và ghi nhận giao dịch nhập hàng." Style="{StaticResource Style.Text.Secondary}" Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Nhập kho" Command="{Binding OpenImportStockCommand}" Style="{StaticResource Style.Button.Primary}" MinWidth="112" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions><ColumnDefinition Width="176" /><ColumnDefinition Width="12" /><ColumnDefinition Width="176" /><ColumnDefinition Width="12" /><ColumnDefinition Width="176" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Style.Card.Default}" Height="78" Padding="14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource Brush.Status.InfoSurface}" VerticalAlignment="Top"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Info}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="Tổng sản phẩm" Style="{StaticResource Style.Text.Secondary}" FontSize="12" /><TextBlock Text="{Binding TotalProducts}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Style.Card.Default}" Height="78" Padding="14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource Brush.Status.WarningSurface}" VerticalAlignment="Top"><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="Sắp hết hàng" Style="{StaticResource Style.Text.Secondary}" FontSize="12" /><TextBlock Text="{Binding LowStockCount}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Style.Card.Default}" Height="78" Padding="14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource Brush.Status.DangerSurface}" VerticalAlignment="Top"><TextBlock Text="&#xEA39;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="Hết hàng" Style="{StaticResource Style.Text.Secondary}" FontSize="12" /><TextBlock Text="{Binding OutOfStockCount}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource Brush.Background.Surface}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="7" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="184" /><ColumnDefinition Width="84" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" ToolTip="Tìm theo tên hoặc mã vạch" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding StockFilters}" SelectedItem="{Binding SelectedStockFilter}" DisplayMemberPath="Name" Style="{StaticResource Style.ComboBox.Default}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Content="Tìm" Command="{Binding LoadInventoryCommand}" Style="{StaticResource Style.Button.Secondary}" />
                <Button Grid.Column="3" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource Style.Button.Secondary}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0" /><TextBlock Text="Làm mới" /></StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.15*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Background="{StaticResource Brush.Background.Surface}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <DataGrid ItemsSource="{Binding InventoryItems}" SelectedItem="{Binding SelectedInventoryItem}" Style="{StaticResource Style.InventoryGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Sản phẩm" Width="2*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="*" />
                            <DataGridTextColumn Header="Tồn kho" Binding="{Binding StockQuantity}" ElementStyle="{StaticResource Style.DataGrid.NumericText}" Width="86" />
                            <DataGridTextColumn Header="Ngưỡng cảnh báo" Binding="{Binding MinStockAlert}" ElementStyle="{StaticResource Style.DataGrid.NumericText}" Width="128" />
                            <DataGridTemplateColumn Header="Trạng thái" Width="98">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="84" Padding="4,3" CornerRadius="4" HorizontalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Brush.Status.SuccessSurface}" /><Style.Triggers><DataTrigger Binding="{Binding StockStatus}" Value="Sắp hết"><Setter Property="Background" Value="{StaticResource Brush.Status.WarningSurface}" /></DataTrigger><DataTrigger Binding="{Binding StockStatus}" Value="Hết hàng"><Setter Property="Background" Value="{StaticResource Brush.Status.DangerSurface}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StockStatus}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" /><Style.Triggers><DataTrigger Binding="{Binding StockStatus}" Value="Sắp hết"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}" /></DataTrigger><DataTrigger Binding="{Binding StockStatus}" Value="Hết hàng"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Danger}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE9F5;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" /><TextBlock Text="Đang tải dữ liệu kho hàng..." Style="{StaticResource Style.Text.Secondary}" Margin="0,8,0,0" /></StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InventoryEmptyVisibility}"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#94A3B8" HorizontalAlignment="Center" /><TextBlock Text="Không có sản phẩm phù hợp với bộ lọc." Style="{StaticResource Style.Text.Secondary}" Margin="0,8,0,0" /></StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Style.Card.Default}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nhập kho" Style="{StaticResource Style.Text.SectionTitle}" /><TextBlock Text="Bổ sung số lượng sản phẩm." Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="{StaticResource Brush.Status.InfoSurface}"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Info}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="7" Padding="12">
                        <Grid IsEnabled="{Binding IsImporting,Converter={StaticResource InverseBooleanConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" /><RowDefinition Height="8" /><RowDefinition Height="38" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="38" />
                                <RowDefinition Height="8" /><RowDefinition Height="38" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="10" /><RowDefinition Height="38" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Quét mã thùng" Style="{StaticResource Style.InventoryFieldLabel}" VerticalAlignment="Center" Margin="0" />
                            <TextBox Grid.Column="1" Text="{Binding CaseBarcodeInput,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" ToolTip="Quét mã vạch thùng rồi nhấn Enter">
                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding FindByCaseBarcodeCommand}" /></TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="Chọn" Command="{Binding FindByCaseBarcodeCommand}" Style="{StaticResource Style.Button.Secondary}" Margin="8,0,0,0" FontSize="12" />

                            <TextBlock Grid.Row="2" Text="Sản phẩm" Style="{StaticResource Style.InventoryFieldLabel}" VerticalAlignment="Center" Margin="0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding ImportProductOptions}" SelectedItem="{Binding SelectedInventoryItem}" DisplayMemberPath="ProductName" Style="{StaticResource Style.ComboBox.Default}" />
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding PackagingHint}" Style="{StaticResource Style.Text.Secondary}" FontSize="11" Margin="92,5,0,0" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="5" Text="{Binding ImportUnitInputLabel}" Style="{StaticResource Style.InventoryFieldLabel}" VerticalAlignment="Center" Margin="0" />
                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ImportUnitQuantityText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" ToolTip="Số đơn vị nhập nguyên thùng/kiện" />
                            <TextBlock Grid.Row="7" Text="{Binding LooseUnitInputLabel}" Style="{StaticResource Style.InventoryFieldLabel}" VerticalAlignment="Center" Margin="0" />
                            <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LooseUnitQuantityText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" ToolTip="Số đơn vị bán lẻ ngoài thùng" />
                            <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Text="{Binding ReceiptSummary}" Style="{StaticResource Style.Text.Secondary}" FontSize="11" Margin="92,5,0,0" />

                            <Button Grid.Row="10" Grid.ColumnSpan="3" Content="Xác nhận nhập kho" Command="{Binding ConfirmImportStockCommand}" Style="{StaticResource Style.Button.Primary}" Height="38" />
                            <StackPanel Grid.Row="11" Grid.ColumnSpan="3"><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Status.Danger}" TextWrapping="Wrap" Margin="0,8,0,0" /><TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource Brush.Status.Success}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Giao dịch gần đây" Style="{StaticResource Style.Text.SectionTitle}" /><TextBlock Grid.Column="1" Text="Lịch sử mới nhất" Style="{StaticResource Style.Text.Secondary}" FontSize="12" VerticalAlignment="Center" /></Grid>
                        <Grid Grid.Row="2">
                            <ListBox ItemsSource="{Binding RecentTransactions}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="0,10" Margin="0,0,14,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TransactionDate,StringFormat={}{0:dd/MM HH:mm}}" Style="{StaticResource Style.Text.Secondary}" FontSize="11" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Type}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" HorizontalAlignment="Right" /><TextBlock Text="{Binding Quantity,StringFormat=SL: {0}}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Margin="0,3,0,0" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding RecentTransactionsEmptyVisibility}"><TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#94A3B8" HorizontalAlignment="Center" /><TextBlock Text="Chưa có giao dịch kho gần đây." Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,8,0,0" /></StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
