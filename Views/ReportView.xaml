<UserControl x:Class="SmartPOS.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartPOS.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <Style x:Key="Style.Report.DatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource Brush.Background.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <DataTemplate x:Key="Template.Report.TopProductRow">
            <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="122" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding QuantitySold}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Revenue,StringFormat={}{0:N0} ₫}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Template.Report.CategoryRow">
            <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="122" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding QuantitySold}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Revenue,StringFormat={}{0:N0} ₫}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24" MinWidth="940">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" />
                <RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" />
                <RowDefinition Height="236" /><RowDefinition Height="16" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Báo cáo" Style="{StaticResource Style.Text.PageTitle}" />
                    <TextBlock Text="Phân tích doanh thu và hiệu quả bán hàng theo khoảng thời gian." Style="{StaticResource Style.Text.Secondary}" Margin="0,6,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Status.Danger}" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Style.Card.Default}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="174" /><ColumnDefinition Width="174" /><ColumnDefinition Width="92" /><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Từ ngày" Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,0,0,5" />
                        <DatePicker SelectedDate="{Binding FromDate}" Style="{StaticResource Style.Report.DatePicker}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Đến ngày" Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,0,0,5" />
                        <DatePicker SelectedDate="{Binding ToDate}" Style="{StaticResource Style.Report.DatePicker}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="7 ngày" Command="{Binding Set7DaysCommand}" Style="{StaticResource Style.Button.Secondary}" Height="38" Margin="12,20,0,0" />
                    <Button Grid.Column="3" Content="Áp dụng" Command="{Binding LoadCommand}" Style="{StaticResource Style.Button.Primary}" Height="38" Margin="8,20,0,0" IsEnabled="{Binding IsLoading,Converter={StaticResource InverseBooleanConverter}}" />
                    <TextBlock Grid.Column="4" Text="Chọn khoảng thời gian để xem số liệu đã hoàn tất." Style="{StaticResource Style.Text.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="16,20,0,0" />
                </Grid>
            </Border>

            <UniformGrid Grid.Row="4" Columns="4">
                <Border Style="{StaticResource Style.Card.Default}" Height="82" Padding="14" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Brush.Status.InfoSurface}" VerticalAlignment="Top"><TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Info}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Doanh thu" Style="{StaticResource Style.Text.Secondary}" FontSize="12" /><TextBlock Text="{Binding TotalRevenue,StringFormat={}{0:N0} ₫}" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource Style.Card.Default}" Height="82" Padding="14" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Brush.Status.InfoSurface}" VerticalAlignment="Top"><TextBlock Text="&#xE719;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Info}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Đơn hàng" Style="{StaticResource Style.Text.Secondary}" FontSize="12" /><TextBlock Text="{Binding TotalOrders}" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource Style.Card.Default}" Height="82" Padding="14" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Brush.Status.SuccessSurface}" VerticalAlignment="Top"><TextBlock Text="&#xEAF5;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Success}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="TB/đơn" Style="{StaticResource Style.Text.Secondary}" FontSize="12" /><TextBlock Text="{Binding AverageOrderValue,StringFormat={}{0:N0} ₫}" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Grid></Border>
                <Border Style="{StaticResource Style.Card.Default}" Height="82" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Brush.Status.WarningSurface}" VerticalAlignment="Top"><TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Sản phẩm đã bán" Style="{StaticResource Style.Text.Secondary}" FontSize="12" /><TextBlock Text="{Binding UnitsSold}" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Grid></Border>
            </UniformGrid>

            <Border Grid.Row="6" Style="{StaticResource Style.Card.DashboardSection}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Doanh thu theo ngày" Style="{StaticResource Style.Text.SectionTitle}" /><TextBlock Text="Biến động doanh thu trong khoảng đã chọn" Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding TotalRevenue,StringFormat=Tổng: {0:N0} ₫}" Style="{StaticResource Style.Text.Secondary}" VerticalAlignment="Center" /></Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding HasReportData,Converter={StaticResource BooleanToVisibilityConverter}}"><Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" /><ItemsControl ItemsSource="{Binding RevenueChartPoints}" VerticalAlignment="Bottom"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid VerticalAlignment="Bottom" Margin="6,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Background="{StaticResource Brush.Action.Primary}" Height="{Binding Height}" Width="34" VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4,4,0,0" /><TextBlock Grid.Row="1" Text="{Binding Revenue,StringFormat={}{0:N0}}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,5,0,0" /><TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ReportEmptyVisibility}"><TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Center" /><TextBlock Text="Không có dữ liệu bán hàng trong khoảng thời gian đã chọn." Style="{StaticResource Style.Text.Secondary}" Margin="0,8,0,0" /></StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Style.Card.DashboardSection}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Margin="16,16,16,0"><TextBlock Text="Sản phẩm bán chạy" Style="{StaticResource Style.Text.SectionTitle}" /><TextBlock Text="Các sản phẩm đóng góp doanh thu cao nhất" Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><Grid Grid.Row="2" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="122" /></Grid.ColumnDefinitions><TextBlock Text="Sản phẩm" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Đã bán" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Grid.Column="2" Text="Doanh thu" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid><Grid Grid.Row="3"><ItemsControl ItemsSource="{Binding TopProducts}" ItemTemplate="{StaticResource Template.Report.TopProductRow}" /><TextBlock Text="Chưa có dữ liệu bán hàng." Style="{StaticResource Style.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" Visibility="{Binding TopProductsEmptyVisibility}" /></Grid></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource Style.Card.DashboardSection}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Margin="16,16,16,0"><TextBlock Text="Doanh thu theo danh mục" Style="{StaticResource Style.Text.SectionTitle}" /><TextBlock Text="So sánh số lượng bán và doanh thu theo nhóm hàng" Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><Grid Grid.Row="2" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="122" /></Grid.ColumnDefinitions><TextBlock Text="Danh mục" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Đã bán" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Grid.Column="2" Text="Doanh thu" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid><Grid Grid.Row="3"><ItemsControl ItemsSource="{Binding CategorySales}" ItemTemplate="{StaticResource Template.Report.CategoryRow}" /><TextBlock Text="Chưa có dữ liệu bán hàng." Style="{StaticResource Style.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" Visibility="{Binding CategorySalesEmptyVisibility}" /></Grid></Grid></Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
