<UserControl x:Class="SmartPOS.Views.POSView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:SmartPOS.Helpers" Unloaded="POSView_OnUnloaded">
 <UserControl.Resources>
  <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
  <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
 </UserControl.Resources>
 <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="Bán hàng" Style="{StaticResource Style.Text.PageTitle}"/><TextBlock Text="Quét mã vạch hoặc tìm sản phẩm để thêm nhanh vào đơn hàng." Style="{StaticResource Style.Text.Secondary}" Margin="0,6,0,0"/></StackPanel>
   <Border Grid.Row="2" Style="{StaticResource Style.Card.Default}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="38"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="152"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions><TextBlock Text="Quét mã vạch / nhập mã sản phẩm" Style="{StaticResource Style.Text.Secondary}" FontSize="12"/><TextBox x:Name="BarcodeTextBox" Grid.Row="2" KeyDown="BarcodeTextBox_OnKeyDown" Text="{Binding BarcodeInput,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" ToolTip="Máy quét HID: quét mã và tự gửi Enter"/><Button Grid.Row="2" Grid.Column="1" Content="{Binding CameraToggleText}" Command="{Binding ToggleCameraCommand}" Style="{StaticResource Style.Button.Secondary}" Margin="10,0,0,0" Height="38" IsEnabled="{Binding IsAddingByBarcode,Converter={StaticResource InverseBooleanConverter}}"/><Button Grid.Row="2" Grid.Column="2" Content="Thêm mã" Command="{Binding AddByBarcodeCommand}" Style="{StaticResource Style.Button.Primary}" Margin="8,0,0,0" Height="38" IsEnabled="{Binding IsAddingByBarcode,Converter={StaticResource InverseBooleanConverter}}"/><TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding BarcodeFeedbackMessage}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/><Style.Triggers><DataTrigger Binding="{Binding IsBarcodeFeedbackError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Danger}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
   <Border Grid.Row="4" Style="{StaticResource Style.Card.Default}" Padding="12" Visibility="{Binding IsCameraScanning,Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="220"/></Grid.RowDefinitions><TextBlock Text="Quét bằng camera" Style="{StaticResource Style.Text.SectionTitle}" FontSize="15"/><TextBlock Text="{Binding CameraStatusMessage}" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/><Style.Triggers><DataTrigger Binding="{Binding IsCameraStatusError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Danger}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border Grid.Row="2" Background="#0F172A" CornerRadius="6" ClipToBounds="True"><Grid><Image Source="{Binding CameraPreview}" Stretch="Uniform"/><TextBlock Text="Đang chờ khung hình camera..." Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CameraPreview,Converter={StaticResource NullToVisibilityConverter}}"/></Grid></Border></Grid></Border>
   <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" ToolTip="Tìm theo tên hoặc mã vạch"/><Button Grid.Column="1" Content="Tìm sản phẩm" Command="{Binding LoadProductsCommand}" Style="{StaticResource Style.Button.Secondary}" Margin="8,0,0,0"/></Grid>
   <Border Grid.Row="8" Style="{StaticResource Style.Card.Default}" Padding="8"><ListBox ItemsSource="{Binding ProductResults}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.AddProductCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding IsInStock}" Style="{StaticResource Style.Button.Secondary}" HorizontalContentAlignment="Stretch" Height="66"><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="5" Background="{StaticResource Brush.Background.SurfaceSecondary}" VerticalAlignment="Center"><Image Source="{Binding ImagePath}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Barcode}" Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding SellingPrice,StringFormat={}{0:N0} ₫}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/><Border Grid.Column="3" Width="76" Padding="4,3" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Brush.Status.SuccessSurface}"/><Style.Triggers><DataTrigger Binding="{Binding StockStatus}" Value="Sắp hết"><Setter Property="Background" Value="{StaticResource Brush.Status.WarningSurface}"/></DataTrigger><DataTrigger Binding="{Binding StockStatus}" Value="Hết hàng"><Setter Property="Background" Value="{StaticResource Brush.Status.DangerSurface}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StockStatus}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
  </Grid>
  <Border Grid.Column="2" Style="{StaticResource Style.Card.Default}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Giỏ hàng" Style="{StaticResource Style.Text.SectionTitle}"/><TextBlock Text="Kiểm tra số lượng trước khi thanh toán" Style="{StaticResource Style.Text.Secondary}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Xóa giỏ" Command="{Binding ClearCartCommand}" Style="{StaticResource Style.Button.Secondary}" Height="32" FontSize="12" Padding="10,0" VerticalAlignment="Center"/></Grid>
   <Grid Grid.Row="2"><ListBox ItemsSource="{Binding CartItems}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="0,12" HorizontalAlignment="Stretch"><Grid HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UnitPrice,StringFormat={}{0:N0} ₫ / sản phẩm}" Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LineTotal,StringFormat={}{0:N0} ₫}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/><StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="−" Command="{Binding DataContext.DecreaseQuantityCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Style.Button.Secondary}" Height="30" Width="30" Padding="0"/><TextBlock Text="{Binding Quantity}" Width="34" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Command="{Binding DataContext.IncreaseQuantityCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Style.Button.Secondary}" Height="30" Width="30" Padding="0"/></StackPanel><Button Grid.Row="1" Grid.Column="1" Content="Xóa" Command="{Binding DataContext.RemoveItemCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Style.Button.Secondary}" Height="30" FontSize="12" Padding="9,0" Margin="12,10,0,0" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Quét mã vạch hoặc chọn sản phẩm để bắt đầu đơn hàng." Style="{StaticResource Style.Text.Secondary}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CartEmptyVisibility}"/></Grid>
   <StackPanel Grid.Row="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tạm tính" Style="{StaticResource Style.Text.Secondary}"/><TextBlock Grid.Column="1" Text="{Binding TotalAmount,StringFormat={}{0:N0} ₫}"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions><TextBlock Text="Giảm giá" Style="{StaticResource Style.Text.Secondary}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding DiscountText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}"/></Grid><Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="TỔNG THANH TOÁN" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding FinalAmount,StringFormat={}{0:N0} ₫}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Brush.Action.Primary}"/></Grid></Border><TextBlock Text="Phương thức thanh toán" Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" DisplayMemberPath="Name" Style="{StaticResource Style.ComboBox.Default}"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Status.Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource Brush.Status.Success}" TextWrapping="Wrap" Margin="0,4,0,0"/><Button Content="Mở hóa đơn PDF" Command="{Binding OpenInvoiceCommand}" Style="{StaticResource Style.Button.Secondary}" Height="32" FontSize="12" Padding="10,0" HorizontalAlignment="Left" Margin="0,7,0,0" Visibility="{Binding HasInvoicePdf,Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Content="Thanh toán" Command="{Binding CheckoutCommand}" Style="{StaticResource Style.Button.Primary}" Margin="0,12,0,0" Height="40" IsEnabled="{Binding IsCheckingOut,Converter={StaticResource InverseBooleanConverter}}"/></StackPanel>
  </Grid></Border>
 </Grid>
</UserControl>
