<UserControl x:Class="SmartPOS.Views.AIChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartPOS.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <Style x:Key="Style.AI.Suggestion" TargetType="Button" BasedOn="{StaticResource Style.Button.Secondary}">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style x:Key="Style.AI.MessageCard" TargetType="Border" BasedOn="{StaticResource Style.Card.Default}">
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="Bạn">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Background" Value="{StaticResource Brush.Action.PrimarySurface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Action.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Template.AI.Message">
            <Border Style="{StaticResource Style.AI.MessageCard}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding Timestamp,StringFormat={}{0:HH:mm}}" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" Margin="16,0,0,0" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Content}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <Border Grid.Row="2" Height="2" Width="44" Background="{StaticResource Brush.Status.Info}" HorizontalAlignment="Left" Margin="0,9,0,0" Visibility="Collapsed" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24" MinWidth="880">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" />
            <RowDefinition Height="16" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" Background="{StaticResource Brush.Status.InfoSurface}" CornerRadius="6" VerticalAlignment="Top" Margin="0,0,10,0">
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Info}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Trợ lý AI" Style="{StaticResource Style.Text.PageTitle}" />
                    <TextBlock Text="Hỏi về doanh thu, sản phẩm, tồn kho và hoạt động cửa hàng." Style="{StaticResource Style.Text.Secondary}" Margin="0,5,0,0" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ClearCommand}" Style="{StaticResource Style.Button.Secondary}" Height="32" FontSize="12" Padding="10,0" IsEnabled="{Binding HasMessages}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0" /><TextBlock Text="Xóa chat" /></StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Brush.Background.Surface}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="Câu hỏi gợi ý" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding SuggestedQuestions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.UseSuggestedCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Style.AI.Suggestion}" Margin="0,0,8,0" IsEnabled="{Binding DataContext.IsSending,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource InverseBooleanConverter}}" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Style.Card.Default}" Padding="16">
            <Grid>
                <ListBox ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource Template.AI.Message}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Focusable" Value="False" /></Style></ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="{Binding MessagesEmptyVisibility}">
                    <Border Width="42" Height="42" Background="{StaticResource Brush.Status.InfoSurface}" CornerRadius="8" HorizontalAlignment="Center"><TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{StaticResource Brush.Status.Info}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Bạn có thể hỏi về doanh thu, sản phẩm bán chạy, tồn kho hoặc đơn hàng gần đây." Style="{StaticResource Style.Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
                <Border Background="{StaticResource Brush.Status.DangerSurface}" BorderBrush="{StaticResource Brush.Status.Danger}" BorderThickness="1" CornerRadius="6" Padding="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,12" Visibility="{Binding HasError,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Status.Danger}" TextWrapping="Wrap" /></Border>
            </Grid>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource Style.Card.Default}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding CurrentQuestion,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" BorderThickness="0" Background="Transparent" ToolTip="Nhập câu hỏi về hoạt động cửa hàng" IsEnabled="{Binding IsSending,Converter={StaticResource InverseBooleanConverter}}" />
                <Button Grid.Column="1" Content="Gửi" Command="{Binding SendCommand}" Style="{StaticResource Style.Button.Primary}" Margin="10,0,0,0" IsEnabled="{Binding IsSending,Converter={StaticResource InverseBooleanConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
