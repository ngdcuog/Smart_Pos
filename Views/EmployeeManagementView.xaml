<UserControl x:Class="SmartPOS.Views.EmployeeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartPOS.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style x:Key="Style.EmployeeGrid.Row" TargetType="DataGridRow" BasedOn="{StaticResource Style.DataGrid.ManagementRow}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#F1F5F9" /><Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.EmployeeGrid" TargetType="DataGrid" BasedOn="{StaticResource Style.DataGrid.Management}">
            <Setter Property="RowHeight" Value="64" /><Setter Property="RowStyle" Value="{StaticResource Style.EmployeeGrid.Row}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="Style.EmployeeFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Secondary}">
            <Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Style.EmployeeReadonlyTextBox" TargetType="TextBox" BasedOn="{StaticResource Style.TextBox.Default}">
            <Style.Triggers><Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="#F8FAFC" /><Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" /></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Nhân viên" Style="{StaticResource Style.Text.PageTitle}" /><TextBlock Text="Quản lý thông tin, vai trò và trạng thái làm việc của nhân viên." Style="{StaticResource Style.Text.Secondary}" Margin="0,6,0,0" /></StackPanel>
            <Button Grid.Column="1" Content="Thêm nhân viên" Command="{Binding AddEmployeeCommand}" Style="{StaticResource Style.Button.Primary}" MinWidth="148" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Brush.Background.Surface}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="7" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="154" /><ColumnDefinition Width="170" /><ColumnDefinition Width="84" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" ToolTip="Tìm theo mã, tên hoặc email" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding RoleFilters}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" Style="{StaticResource Style.ComboBox.Default}" />
                <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Name" Style="{StaticResource Style.ComboBox.Default}" />
                <Button Grid.Column="3" Margin="8,0,0,0" Content="Tìm" Command="{Binding LoadEmployeesCommand}" Style="{StaticResource Style.Button.Secondary}" />
                <Button Grid.Column="4" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource Style.Button.Secondary}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0" /><TextBlock Text="Làm mới" /></StackPanel></Button>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Border Background="{StaticResource Brush.Status.DangerSurface}" BorderBrush="{StaticResource Brush.Status.Danger}" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="{Binding HasError,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Status.Danger}" /></Border>
            <Border Background="{StaticResource Brush.Status.SuccessSurface}" BorderBrush="{StaticResource Brush.Status.Success}" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="{Binding HasSuccess,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource Brush.Status.Success}" /></Border>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.36*" MinWidth="340" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Brush.Background.Surface}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" Style="{StaticResource Style.EmployeeGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nhân viên" Width="1.4*">
                                <DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource Style.DataGrid.ManagementCell}"><Setter Property="Padding" Value="18,0,12,0" /></Style></DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding EmployeeCode}" Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,3,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Liên hệ" Width="1.25*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Email}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Phone}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="64" />
                            <DataGridTemplateColumn Header="Trạng thái" Width="92">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="84" Padding="4,3" CornerRadius="4" HorizontalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Brush.Status.SuccessSurface}" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Background" Value="{StaticResource Brush.Status.DangerSurface}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Danger}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Khuôn mặt" Width="92">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="84" Padding="4,3" CornerRadius="4" HorizontalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Brush.Status.SuccessSurface}" /><Style.Triggers><DataTrigger Binding="{Binding HasFaceSamples}" Value="False"><Setter Property="Background" Value="{StaticResource Brush.Background.SurfaceSecondary}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding FaceStatusText}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" /><Style.Triggers><DataTrigger Binding="{Binding HasFaceSamples}" Value="False"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Tác vụ" Width="142">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Button Content="{Binding FaceActionText}" Command="{Binding DataContext.EnrollFaceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Style.Button.Secondary}" Height="26" Width="128" FontSize="11" Padding="6,0" /><Button Content="{Binding StatusAction}" Command="{Binding DataContext.ToggleEmployeeStatusCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Style.Button.Secondary}" Height="26" Width="128" FontSize="11" Padding="6,0" Margin="0,4,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE9F5;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" /><TextBlock Text="Đang tải danh sách nhân viên..." Style="{StaticResource Style.Text.Secondary}" Margin="0,8,0,0" /></StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmployeesEmptyVisibility}"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#94A3B8" HorizontalAlignment="Center" /><TextBlock Text="Không có nhân viên phù hợp với bộ lọc." Style="{StaticResource Style.Text.Secondary}" Margin="0,8,0,0" /></StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Style.Card.Default}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Style.Text.SectionTitle}" /><TextBlock Text="Cập nhật hồ sơ và vai trò làm việc." Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="{StaticResource Brush.Status.InfoSurface}"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Info}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                        <StackPanel IsEnabled="{Binding IsSaving,Converter={StaticResource InverseBooleanConverter}}">
                            <TextBlock Text="THÔNG TIN CƠ BẢN" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,0,0,10" />
                            <TextBlock Text="Mã nhân viên" Style="{StaticResource Style.EmployeeFieldLabel}" />
                            <TextBox Text="{Binding EmployeeCode,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.EmployeeReadonlyTextBox}" Margin="0,0,0,12" IsReadOnly="{Binding IsNewEmployee,Converter={StaticResource InverseBooleanConverter}}" />
                            <TextBlock Text="Họ tên" Style="{StaticResource Style.EmployeeFieldLabel}" /><TextBox Text="{Binding FullName,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" Margin="0,0,0,12" />
                            <TextBlock Text="Email" Style="{StaticResource Style.EmployeeFieldLabel}" /><TextBox Text="{Binding Email,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" Margin="0,0,0,12" />
                            <TextBlock Text="Điện thoại" Style="{StaticResource Style.EmployeeFieldLabel}" /><TextBox Text="{Binding Phone,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" Margin="0,0,0,18" />
                            <TextBlock Text="VAI TRÒ &amp; TRẠNG THÁI" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,0,0,10" />
                            <TextBlock Text="Vai trò" Style="{StaticResource Style.EmployeeFieldLabel}" /><ComboBox ItemsSource="{Binding EditorRoles}" SelectedItem="{Binding EditorRole}" DisplayMemberPath="Name" Style="{StaticResource Style.ComboBox.Default}" />
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0"><StackPanel><TextBlock Text="Trạng thái làm việc" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Kích hoạt, vô hiệu hóa và đăng ký khuôn mặt được thao tác trực tiếp tại bảng." Style="{StaticResource Style.Text.Secondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="3" Content="Lưu nhân viên" Command="{Binding SaveEmployeeCommand}" Style="{StaticResource Style.Button.Primary}" Height="38" Margin="0,16,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
