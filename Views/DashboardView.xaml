<UserControl x:Class="SmartPOS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="Template.Dashboard.LowStockRow">
            <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="10,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StockQuantity}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Width="76" Padding="4,3" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Brush.Status.WarningSurface}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Hết hàng"><Setter Property="Background" Value="{StaticResource Brush.Status.DangerSurface}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Hết hàng"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Danger}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Template.Dashboard.TopProductRow">
            <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding QuantitySold}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Revenue,StringFormat={}{0:N0} ₫}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Template.Dashboard.RecentOrderRow">
            <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding OrderId,StringFormat=# {0}}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding OrderDate,StringFormat={}{0:HH:mm}}" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding FinalAmount,StringFormat={}{0:N0} ₫}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24" MinWidth="900">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="276" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tổng quan" Style="{StaticResource Style.Text.PageTitle}" />
                    <TextBlock Text="Theo dõi nhanh hoạt động vận hành cửa hàng." Style="{StaticResource Style.Text.Secondary}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Status.Danger}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding LoadCommand}" Style="{StaticResource Style.Button.Secondary}" MinWidth="104" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" /><TextBlock Text="Làm mới" /></StackPanel>
                </Button>
            </Grid>

            <UniformGrid Grid.Row="2" Columns="4">
                <Border Style="{StaticResource Style.Card.Default}" Height="92" Padding="16" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource Brush.Status.InfoSurface}" VerticalAlignment="Top"><TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Info}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Doanh thu hôm nay" Style="{StaticResource Style.Text.Secondary}"/><TextBlock Text="{Binding RevenueToday,StringFormat={}{0:N0} ₫}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Style.Card.Default}" Height="92" Padding="16" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource Brush.Status.InfoSurface}" VerticalAlignment="Top"><TextBlock Text="&#xE719;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Info}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Đơn hàng hôm nay" Style="{StaticResource Style.Text.Secondary}"/><TextBlock Text="{Binding OrdersToday}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Style.Card.Default}" Height="92" Padding="16" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource Brush.Status.WarningSurface}" VerticalAlignment="Top"><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Sắp hết hàng" Style="{StaticResource Style.Text.Secondary}"/><TextBlock Text="{Binding LowStockCount}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource Style.Card.Default}" Height="92" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource Brush.Status.SuccessSurface}" VerticalAlignment="Top"><TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Đã chấm công hôm nay" Style="{StaticResource Style.Text.Secondary}"/><TextBlock Text="{Binding AttendanceToday}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
            </UniformGrid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Style.Card.DashboardSection}" Padding="20">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Doanh thu 7 ngày" Style="{StaticResource Style.Text.SectionTitle}"/><TextBlock Text="Xu hướng doanh thu theo ngày" Style="{StaticResource Style.Text.Secondary}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SevenDayRevenue,StringFormat=Tổng 7 ngày: {0:N0} ₫}" Style="{StaticResource Style.Text.Secondary}" VerticalAlignment="Center"/></Grid>
                        <Grid Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding HasRevenueData,Converter={StaticResource BooleanToVisibilityConverter}}"><Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1"/><ItemsControl ItemsSource="{Binding RevenueChartPoints}" VerticalAlignment="Bottom"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid VerticalAlignment="Bottom" Margin="7,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{StaticResource Brush.Action.Primary}" Height="{Binding Height}" Width="38" VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4,4,0,0"/><TextBlock Grid.Row="1" Text="{Binding Revenue,StringFormat={}{0:N0}}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/><TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                        <TextBlock Grid.Row="1" Text="Chưa có doanh thu trong 7 ngày gần nhất." Style="{StaticResource Style.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding RevenueEmptyVisibility}"/>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Style.Card.DashboardSection}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Sản phẩm sắp hết" Style="{StaticResource Style.Text.SectionTitle}"/><TextBlock Text="Ưu tiên nhập thêm các mặt hàng này" Style="{StaticResource Style.Text.Secondary}" Margin="0,4,0,0"/></StackPanel>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><TextBlock Text="Sản phẩm" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" Margin="10,0"/><TextBlock Grid.Column="1" Text="Tồn" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,10,0"/><TextBlock Grid.Column="2" Text="Trạng thái" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,10,0"/></Grid>
                        <Grid Grid.Row="3"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding LowStockProducts}" ItemTemplate="{StaticResource Template.Dashboard.LowStockRow}"/></ScrollViewer><TextBlock Text="Không có sản phẩm cần cảnh báo tồn kho." Style="{StaticResource Style.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LowStockEmptyVisibility}"/></Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Style.Card.DashboardSection}" MinHeight="194">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Sản phẩm bán chạy" Style="{StaticResource Style.Text.SectionTitle}"/>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Sản phẩm" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" Margin="10,0"/><TextBlock Grid.Column="1" Text="Đã bán" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,10,0"/><TextBlock Grid.Column="2" Text="Doanh thu" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,10,0"/></Grid>
                        <Grid Grid.Row="3"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding TopProducts}" ItemTemplate="{StaticResource Template.Dashboard.TopProductRow}"/></ScrollViewer><TextBlock Text="Chưa có dữ liệu bán hàng." Style="{StaticResource Style.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding TopProductsEmptyVisibility}"/></Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Style.Card.DashboardSection}" MinHeight="194">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Đơn hàng gần đây" Style="{StaticResource Style.Text.SectionTitle}"/>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Mã đơn" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" Margin="10,0"/><TextBlock Grid.Column="1" Text="Thời gian" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" Margin="10,0"/><TextBlock Grid.Column="2" Text="Tổng tiền" Style="{StaticResource Style.Text.Secondary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,10,0"/></Grid>
                        <Grid Grid.Row="3"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding RecentOrders}" ItemTemplate="{StaticResource Template.Dashboard.RecentOrderRow}"/></ScrollViewer><TextBlock Text="Chưa có đơn hàng gần đây." Style="{StaticResource Style.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding RecentOrdersEmptyVisibility}"/></Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
