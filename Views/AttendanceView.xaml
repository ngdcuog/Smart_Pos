<UserControl x:Class="SmartPOS.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartPOS.Helpers"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style x:Key="Style.AttendanceGrid.Row" TargetType="DataGridRow" BasedOn="{StaticResource Style.DataGrid.ManagementRow}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#F1F5F9" /><Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.AttendanceGrid" TargetType="DataGrid" BasedOn="{StaticResource Style.DataGrid.Management}">
            <Setter Property="RowHeight" Value="52" /><Setter Property="RowStyle" Value="{StaticResource Style.AttendanceGrid.Row}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="Style.AttendanceFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Secondary}">
            <Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Style.AttendanceTimeHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.DataGrid.ManagementHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Style.AttendanceTimeCell" TargetType="DataGridCell" BasedOn="{StaticResource Style.DataGrid.ManagementCell}">
            <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Style.AttendanceTimeText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Chấm công" Style="{StaticResource Style.Text.PageTitle}" />
            <TextBlock Text="Quét QR hoặc nhập mã nhân viên để xác định và chấm công." Style="{StaticResource Style.Text.Secondary}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Style.Card.Default}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Mã nhân viên / QR" Style="{StaticResource Style.Text.SectionTitle}" /><TextBlock Text="Thao tác chính để bắt đầu chấm công." Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="{StaticResource Brush.Status.InfoSurface}"><TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Info}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions><TextBox x:Name="EmployeeCodeTextBox" Text="{Binding EmployeeCodeInput,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style.TextBox.Default}" ToolTip="Nhập hoặc quét mã nhân viên" /><Button Grid.Column="1" Content="Xác định" Command="{Binding IdentifyEmployeeCommand}" Style="{StaticResource Style.Button.Primary}" Margin="8,0,0,0" /></Grid>
                    <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Top" /><TextBlock Grid.Column="1" Text="{Binding FaceStatus}" Style="{StaticResource Style.Text.Secondary}" FontSize="12" TextWrapping="Wrap" /></Grid></Border>
                    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="Xác thực khuôn mặt" Command="{Binding VerifyFaceCommand}" IsEnabled="{Binding CanVerifyFace}" Style="{StaticResource Style.Button.Secondary}" Height="34" FontSize="12" Padding="12,0" /><Button Grid.Column="2" Content="Dùng mã nhân viên" Command="{Binding UseCodeFallbackCommand}" Style="{StaticResource Style.Button.Secondary}" Height="34" FontSize="12" Padding="12,0" /><TextBlock Grid.Column="3" Text="{Binding FaceAttempts,StringFormat=Lần thử: {0}/3}" Style="{StaticResource Style.Text.Secondary}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsFaceEnrolled,Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Style.Card.Default}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nhân viên đã xác định" Style="{StaticResource Style.Text.SectionTitle}" /><TextBlock Text="Thông tin cần kiểm tra trước khi chấm công." Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="{StaticResource Brush.Status.SuccessSurface}"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Status.Success}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="7" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding SummaryEmployeeName}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Row="1" Text="{Binding SummaryEmployeeCode}" Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /><Border Grid.Row="3" Background="{StaticResource Brush.Status.InfoSurface}" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left"><TextBlock FontSize="12" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Chưa check-in hôm nay" /><Setter Property="Foreground" Value="{StaticResource Brush.Status.Info}" /><Style.Triggers><DataTrigger Binding="{Binding IdentifiedEmployee.HasCheckedInToday}" Value="True"><Setter Property="Text" Value="Đã check-in · chờ check-out" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IdentifiedEmployee.HasCheckedInToday}" Value="True" /><Condition Binding="{Binding IdentifiedEmployee.HasCheckedOutToday}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Text" Value="Đã hoàn tất hôm nay" /><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></Grid></Border>
                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="Chấm công vào" Command="{Binding CheckInCommand}" IsEnabled="{Binding CanCheckIn}" Style="{StaticResource Style.Button.Primary}" Height="38" /><Button Grid.Column="2" Content="Chấm công ra" Command="{Binding CheckOutCommand}" IsEnabled="{Binding CanCheckOut}" Style="{StaticResource Style.Button.Secondary}" Height="38" /></Grid>
                    <Grid Grid.Row="6"><Border Background="{StaticResource Brush.Status.SuccessSurface}" BorderBrush="{StaticResource Brush.Status.Success}" BorderThickness="1" CornerRadius="6" Padding="9" Visibility="{Binding HasSuccess,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource Brush.Status.Success}" FontSize="12" TextWrapping="Wrap" /></Border><Border Background="{StaticResource Brush.Status.DangerSurface}" BorderBrush="{StaticResource Brush.Status.Danger}" BorderThickness="1" CornerRadius="6" Padding="9" Visibility="{Binding HasError,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Status.Danger}" FontSize="12" TextWrapping="Wrap" /></Border></Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource Brush.Background.Surface}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="7" MaxHeight="390" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="16,14,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Chấm công hôm nay" Style="{StaticResource Style.Text.SectionTitle}" /><TextBlock Text="Lịch sử check-in và check-out trong ngày." Style="{StaticResource Style.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding TodayRecords.Count,StringFormat={}{0} lượt}" Style="{StaticResource Style.Text.Secondary}" FontSize="12" VerticalAlignment="Center" /></Grid>
                <Grid Grid.Row="2"><DataGrid ItemsSource="{Binding TodayRecords}" Style="{StaticResource Style.AttendanceGrid}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Mã NV" Binding="{Binding EmployeeCode}" Width="100"><DataGridTextColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource Style.DataGrid.ManagementCell}"><Setter Property="Padding" Value="18,0,12,0" /></Style></DataGridTextColumn.CellStyle></DataGridTextColumn><DataGridTemplateColumn Header="Nhân viên" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Check-in" Binding="{Binding CheckInTime,StringFormat={}{0:HH:mm}}" HeaderStyle="{StaticResource Style.AttendanceTimeHeader}" CellStyle="{StaticResource Style.AttendanceTimeCell}" ElementStyle="{StaticResource Style.AttendanceTimeText}" Width="100" /><DataGridTextColumn Header="Check-out" Binding="{Binding CheckOutTime,StringFormat={}{0:HH:mm}}" HeaderStyle="{StaticResource Style.AttendanceTimeHeader}" CellStyle="{StaticResource Style.AttendanceTimeCell}" ElementStyle="{StaticResource Style.AttendanceTimeText}" Width="100" /><DataGridTemplateColumn Header="Trạng thái" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="96" Padding="4,3" CornerRadius="4" HorizontalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Brush.Status.SuccessSurface}" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Đi trễ"><Setter Property="Background" Value="{StaticResource Brush.Status.WarningSurface}" /></DataTrigger><DataTrigger Binding="{Binding CheckOutTime}" Value="{x:Null}"><Setter Property="Background" Value="{StaticResource Brush.Status.InfoSurface}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock FontSize="12" FontWeight="SemiBold" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Status}" /><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Đi trễ"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}" /></DataTrigger><DataTrigger Binding="{Binding CheckOutTime}" Value="{x:Null}"><Setter Property="Text" Value="Chưa checkout" /><Setter Property="Foreground" Value="{StaticResource Brush.Status.Info}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE9F5;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" /><TextBlock Text="Đang tải dữ liệu chấm công..." Style="{StaticResource Style.Text.Secondary}" Margin="0,8,0,0" /></StackPanel><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding TodayRecordsEmptyVisibility}"><TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#94A3B8" HorizontalAlignment="Center" /><TextBlock Text="Chưa có lượt chấm công hôm nay." Style="{StaticResource Style.Text.Secondary}" Margin="0,8,0,0" /></StackPanel></Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
