<Window x:Class="SmartPOS.Views.FaceEnrollmentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Đăng ký khuôn mặt" Width="880" Height="600" WindowStartupLocation="CenterOwner" Loaded="OnLoaded" Closed="OnClosed"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Đăng ký khuôn mặt" Style="{StaticResource Style.Text.PageTitle}"/><TextBlock Text="{Binding EmployeeName}" Style="{StaticResource Style.Text.Body}" Margin="0,8,0,0"/><TextBlock Text="{Binding EmployeeCode}" Style="{StaticResource Style.Text.Secondary}"/></StackPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Style.Card.Default}"><Image Source="{Binding CameraPreview}" Stretch="Uniform"/></Border><Border Grid.Column="2" Style="{StaticResource Style.Card.Default}"><StackPanel><TextBlock Text="Trạng thái" Style="{StaticResource Style.Text.SectionTitle}"/><TextBlock Text="{Binding CapturedSamples,StringFormat=Mẫu: {0}/20}" Style="{StaticResource Style.Text.Body}" Margin="0,12,0,0"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Style.Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding Instruction}" Style="{StaticResource Style.Text.Secondary}" Margin="0,18,0,0"/></StackPanel></Border></Grid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Đóng" IsCancel="True" Style="{StaticResource Style.Button.Secondary}" Margin="0,0,8,0"/><Button Content="Bắt đầu đăng ký" Command="{Binding StartEnrollmentCommand}" Style="{StaticResource Style.Button.Primary}"/></StackPanel></Grid></Window>
